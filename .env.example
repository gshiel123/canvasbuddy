# ---------------------------------------------------------------------------
# Canvas Buddy configuration.  Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# Canvas -------------------------------------------------------------------
CANVAS_BASE_URL=
# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
CANVAS_TOKEN=

# id:CODE pairs, comma separated.  Run `python -m canvas_buddy.run courses` to list them.
CANVAS_COURSES=

# Notifications ------------------------------------------------------------
# Telegram: message @BotFather -> /newbot -> copy the token below,
# then run `python -m canvas_buddy.run setup-telegram` to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Email (optional).  For Gmail use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Behaviour ----------------------------------------------------------------
POLL_MINUTES=45
DUE_SOON_DAYS=7
TZ=Europe/Dublin
CANVAS_BUDDY_DB=data/state.db

# Turn any of these off if a section gets noisy.
WATCH_ANNOUNCEMENTS=true
WATCH_DISCUSSIONS=true
WATCH_ASSIGNMENTS=true
WATCH_SYLLABUS=true
WATCH_MODULES=true
WATCH_PAGES=true
WATCH_FILES=true
